@layouts.landing({ title: `Bisikin ke ${profile.username} 🌿` })
  @slot('meta')
    <meta name="data-username" content="{{ profile.username }}" />
    <meta name="description" content="Profile page" />
    <meta name="data-page" content="profile" />
  @endslot
  
  @slot('main')
    <div class="relative min-h-full py-12 px-4 md:px-16 lg:px-32">
      <div class="max-w-2xl mx-auto space-y-8">
        <!-- Profile Header -->
        <div
          class="bg-white/30 backdrop-blur-sm rounded-2xl p-8 shadow-sm text-center animate-fade-in-up glow-soft"
        >
          @if(profile.avatar)
            <img
              id="profile-avatar"
              src="{{ profile.avatar }}"
              alt="Avatar of {{ profile.username }}"
              class="w-24 h-24 mx-auto mb-6 rounded-full object-cover border-4 border-white/30 shadow-sm backdrop-blur-sm animate-floating"
            />
          @else
            <div
              class="w-24 h-24 mx-auto mb-6 bg-white/40 rounded-full flex items-center justify-center text-4xl backdrop-blur-sm animate-floating"
            >
              🌿
            </div>
          @end
          <h1 id="profile-username" class="text-2xl font-medium text-gray-700 mb-3">
            {{ '@' + profile.username }}
          </h1>
          <p id="profile-bio" class="text-gray-600 font-light leading-relaxed max-w-md mx-auto">
            "{{ profile.bio || 'Belum ada bio' }}"
          </p>
        </div>

        <!-- Message Form -->
        <div class="bg-white/30 backdrop-blur-sm rounded-2xl p-8 shadow-sm animate-slide-up glow-soft">
          <h2 id="form-title" class="text-xl font-medium text-gray-700 mb-6 text-center">
            Kirim pesan ke {{ profile.username }}
          </h2>

          <form id="message-form" class="space-y-6">
            {{ csrfField() }}
            <!-- Textarea -->
            <div>
              <textarea
                id="message-input"
                placeholder="Tulis pesanmu di sini..."
                class="w-full h-32 p-4 bg-white/40 backdrop-blur-sm rounded-xl border-0 resize-none focus:outline-none focus:ring-2 focus:ring-[--color-primary]/50 text-gray-700 placeholder-gray-500"
                required
              ></textarea>
            </div>

            <!-- Mode Toggle -->
            <div class="space-y-4">
              <div class="flex justify-center">
                <div class="relative inline-flex bg-white/40 backdrop-blur-md rounded-full p-1 shadow-inner">
                  <!-- Anonim -->
                  <label class="cursor-pointer">
                    <input type="radio" name="mode" value="anonymous" checked class="hidden peer" />
                    <div
                      class="peer-checked:bg-[--color-primary] peer-checked:text-gray-800 text-gray-600 px-6 py-2 rounded-full transition-all duration-300 ease-out font-medium hover:text-gray-700"
                    >
                      🎭 Anonim
                    </div>
                  </label>

                  <!-- Blak-blakan -->
                  <label class="cursor-pointer">
                    <input type="radio" name="mode" value="open" class="hidden peer" />
                    <div
                      class="peer-checked:bg-[--color-primary] peer-checked:text-gray-800 text-gray-600 px-6 py-2 rounded-full transition-all duration-300 ease-out font-medium hover:text-gray-700"
                    >
                      💬 Blak-blakan
                    </div>
                  </label>

                  <!-- highlight glow -->
                  <div
                    class="absolute inset-0 rounded-full pointer-events-none border border-white/30 shadow-[inset_0_1px_4px_rgba(255,255,255,0.2)]"
                  >
                  </div>
                </div>
              </div>

              <div id="clue-field" class="mode-transition">
                <input
                  id="clue-input"
                  type="text"
                  placeholder="Kasih petunjuk kecil... (opsional)"
                  class="w-full p-3 bg-white/40 backdrop-blur-sm rounded-xl border-0 focus:outline-none focus:ring-2 focus:ring-[--color-primary]/50 text-gray-700 placeholder-gray-500"
                />
              </div>

              <div id="name-field" class="mode-transition hidden">
                <input
                  id="name-input"
                  type="text"
                  placeholder="Nama kamu..."
                  class="w-full p-3 bg-white/40 backdrop-blur-sm rounded-xl border-0 focus:outline-none focus:ring-2 focus:ring-[--color-primary]/50 text-gray-700 placeholder-gray-500"
                />
              </div>
            </div>

            <!-- Submit -->
            <div class="text-center">
              <button
                type="submit"
                id="submit-btn"
                class="bg-[--color-primary] hover:bg-[#8bb4b1] text-gray-800 font-medium px-8 py-3 rounded-full shadow-sm transition-all disabled:opacity-50 disabled:cursor-not-allowed"
              >
                <span id="submit-text">Kirim Pesan</span>
                <div
                  id="submit-spinner"
                  class="loading-spinner w-5 h-5 border-2 border-gray-800 border-t-transparent rounded-full hidden ml-2 justify-items-center"
                >
                </div>
              </button>
            </div>
          </form>
        </div>

        <!-- Message Preview -->
        <div class="animate-fade-in-up-more-delayed">
          <h3 class="text-xl font-light text-gray-700 mb-6 text-center">
            Beberapa bisikan yang sudah dikirim 🌿
          </h3>
          <div id="messages-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
          </div>

          @if(messages.length > 0)
            <div id="messages-grid" class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
              @each((message, index) in messages)
                <div
                  class="message-card bg-white/20 backdrop-blur-lg rounded-xl p-4 text-gray-700 italic blur-message 
          {{ index % 3 === 0 ? 'animate-floating' : index % 3 === 1 ? 'animate-floating-delayed' : 'animate-floating-more-delayed' }}"
                  style="animation-delay: {{ index * 0.1 }}s;"
                >
                  <p class="line-clamp-3 mb-3">
                    "{{ message.message }}"
                  </p>
                  <div class="text-xs text-gray-500 flex items-center justify-between">
                    <span>
                      {{ message.isAnonymous ? '🎭 Anonim' : '💬 ' + (message.senderName || 'Blak-blakan') }}
            </span>

                    @if(message.clue)
                      <span class="text-[--color-primary]">💡 {{ message.clue }}</span>
                    @endif
                  </div>
                </div>
              @endeach
            </div>
          @else
            <div id="no-messages" class="text-center py-12">
              <div class="text-6xl mb-4 animate-floating-delayed">
                💭
              </div>
              <p class="text-gray-600 font-light">
                Belum ada bisikan yang masuk...
              </p>
              <p class="text-gray-500 text-sm mt-2">
                Bagikan profil ini untuk mulai menerima pesan!
              </p>
            </div>
          @endif
        </div>

        <div class="relative z-10 mt-20 text-center">
          <div
            class="max-w-lg mx-auto bg-white/30 backdrop-blur-md rounded-2xl px-6 py-8 shadow-sm border border-white/40 glow-soft"
          >
            <div class="mb-4 text-3xl animate-floating">
              🌿
            </div>
            <p class="text-gray-700 font-light leading-relaxed text-sm md:text-base mb-4">
              Ingin punya ruang bisikan seperti ini?  
      <br />
              Ciptakan milikmu sendiri dan dengarkan cerita orang lain 🍃
            </p>

            <a
              href="/"
              class="inline-block mt-3 px-6 py-2.5 rounded-full bg-[--color-primary] text-gray-800 font-medium hover:bg-[#8bb4b1] transition-all shadow-sm"
            >
              Buat Profil
    </a>
          </div>
        </div>

      </div>
    </div>

    <!-- Toast -->
    <div id="toast" class="toast">
      <span id="toast-message"></span>
    </div>
  @endslot
@end
